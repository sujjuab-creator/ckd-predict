# Backend Environment Variables Template (Production Cloud Deployment)
# Copy to backend/.env for local development. Never commit real values.
# Aiven: paste the Service URI unchanged, e.g. mysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=
# Optional: Aiven CA certificate (path to ca.pem, or the PEM text) to verify the server certificate
DATABASE_SSL_CA=
SECRET_KEY=
FRONTEND_URL=
CORS_ORIGIN=
FLASK_ENV=production
PORT=5000

# Single System Administrator — used ONLY to create the admin when none exists yet.
# ADMIN_PASSWORD is required (min 8 chars, no default). Only one admin is ever created; if the existing
# admin's email matches ADMIN_EMAIL, its password is synchronised to ADMIN_PASSWORD on startup.
# In production, startup fails with a clear error if no admin exists and ADMIN_PASSWORD is missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=System Administrator

# ---------------- Email (OTP verification + password reset) ----------------
# Production (Render free plan): use Brevo's HTTPS transactional API.
#   MAIL_PROVIDER=brevo  + BREVO_API_KEY (Brevo > SMTP & API > API keys)
#   MAIL_FROM must be a sender verified in Brevo (Senders, domains & dedicated IPs).
#   Set the real key only in Render's Environment settings — never commit it.
# Other options: smtp (local / paid hosting only — Render free blocks SMTP ports
# 25/465/587), sendgrid (SENDGRID_API_KEY), resend (RESEND_API_KEY).
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=your-verified-sender@example.com
MAIL_FROM_NAME=CKD Predict

# SMTP settings — only used when MAIL_PROVIDER=smtp (Gmail: smtp.gmail.com, port 587, TLS, and a Google *App Password* —
# not your normal Gmail password; requires 2-Step Verification on the Google account)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Optional alternative HTTPS providers (only the one matching MAIL_PROVIDER is used)
SENDGRID_API_KEY=
RESEND_API_KEY=
