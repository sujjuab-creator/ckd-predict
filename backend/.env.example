# Backend Environment Variables Template (Production Cloud Deployment)
# Copy to backend/.env for local development. Never commit real values.
DATABASE_URL=
SECRET_KEY=
FRONTEND_URL=
CORS_ORIGIN=
FLASK_ENV=production
PORT=5000

# Single System Administrator — used ONLY to create the admin when none exists yet.
# ADMIN_PASSWORD is required (min 8 chars, no default). An existing admin is never overwritten.
# In production, startup fails with a clear error if no admin exists and ADMIN_PASSWORD is missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=System Administrator

# ---------------- Email (OTP verification + password reset) ----------------
# MAIL_PROVIDER: smtp | brevo | sendgrid | resend
#   smtp      -> works locally and on paid hosting. Render FREE web services block
#                outbound SMTP ports 25/465/587, so use brevo, sendgrid, or resend there.
#   brevo     -> HTTPS email API (set BREVO_API_KEY)
#   sendgrid  -> HTTPS email API (set SENDGRID_API_KEY)
#   resend    -> HTTPS email API (set RESEND_API_KEY)
MAIL_PROVIDER=smtp
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=CKD PREDICT

# SMTP settings (Gmail: smtp.gmail.com, port 587, TLS, and a Google *App Password* —
# not your normal Gmail password; requires 2-Step Verification on the Google account)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# HTTPS email API keys (only the one matching MAIL_PROVIDER is needed)
BREVO_API_KEY=
SENDGRID_API_KEY=
RESEND_API_KEY=
