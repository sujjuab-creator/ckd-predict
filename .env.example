# CKD Predict — Environment Variables Template (Production Cloud Deployment)

# Backend Environment Variables
DATABASE_URL=
SECRET_KEY=
FRONTEND_URL=
CORS_ORIGIN=
FLASK_ENV=production
PORT=5000

# Initial System Administrator (required only when no admin exists yet; no default password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=System Administrator

# Email for OTP verification and password reset (see backend/.env.example for details)
# MAIL_PROVIDER: smtp | brevo | sendgrid  (Render free plan blocks SMTP -> use brevo or sendgrid)
MAIL_PROVIDER=smtp
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=CKD PREDICT
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
BREVO_API_KEY=
SENDGRID_API_KEY=

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=
