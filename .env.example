# CKD Predict — Environment Variables Template (Production Cloud Deployment)

# Backend Environment Variables
DATABASE_URL=
SECRET_KEY=
FRONTEND_URL=
CORS_ORIGIN=
FLASK_ENV=production
PORT=5000

# Initial System Administrator (required only when no admin exists yet; no default password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=System Administrator

# Email for OTP verification and password reset (see backend/.env.example for details)
# Production: Brevo HTTPS API (Render free plan blocks SMTP). Set the real key only in Render.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=your-verified-sender@example.com
MAIL_FROM_NAME=CKD Predict
# Optional alternatives: smtp | sendgrid | resend
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
SENDGRID_API_KEY=
RESEND_API_KEY=

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=
